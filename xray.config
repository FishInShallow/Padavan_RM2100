# xray 独立插件 NVRAM 默认配置模板
# 编译时会被合并到固件默认值
# 位置: /opt/rt-n56u/trunk/user/xray/xray.config

# ============================================================
# 核心开关
# ============================================================
CONFIG_XRAY_ENABLE=n
CONFIG_XRAY_VERSION=26.10.31

# ============================================================
# 运行模式
# ============================================================
# gfw      - GFW 列表模式 (默认直连，GFW 列表走代理)
# router   - 绕过大陆模式 (默认走代理，大陆 IP 直连)
# all      - 全局模式 (全部走代理)
# oversea  - 海外模式 (大陆 IP 走代理，其余直连)
CONFIG_XRAY_RUN_MODE=router

# ============================================================
# 连接设置
# ============================================================
CONFIG_XRAY_THREADS=0              # 0=自动(CPU核心数)
CONFIG_XRAY_LOCAL_PORT=1080        # 透明代理端口 (dokodemo-door)
CONFIG_XRAY_SOCKS_PORT=1081        # SOCKS5 端口
CONFIG_XRAY_HTTP_PORT=0            # HTTP 代理端口 (0=禁用)
CONFIG_XRAY_TUN_ENABLE=n           # TUN 透明代理 (xray 26.10+)
CONFIG_XRAY_PROXY_LOCAL=n          # 本机流量走代理

# ============================================================
# 节点管理
# ============================================================
CONFIG_XRAY_GLOBAL_SERVER=0        # 当前主节点索引
CONFIG_XRAY_UDP_SERVER=same        # UDP 节点: same/0/索引
CONFIG_XRAY_NODE_MAX=0             # 节点总数 (内部维护)

# ============================================================
# DNS 设置
# ============================================================
# local    - 仅本地 DNS
# remote   - 仅远程 DNS
# fakeip   - FakeIP 模式 (需 TUN 支持)
CONFIG_XRAY_DNS_MODE=local
CONFIG_XRAY_FAKEIP_RANGE=198.18.0.0/16
CONFIG_XRAY_LOCAL_DNS=223.5.5.5,114.114.114.114
CONFIG_XRAY_REMOTE_DNS=1.1.1.1,8.8.8.8
CONFIG_XRAY_DOH_DNS=https://1.1.1.1/dns-query,https://8.8.8.8/dns-query

# ============================================================
# TLS/Reality 通用
# ============================================================
CONFIG_XRAY_TLS_INSECURE=n         # 允许不安全证书
CONFIG_XRAY_FINGERPRINT=chrome     # 指纹: chrome,firefox,safari,ios,android,edge,360,qq,random,randomized

# ============================================================
# 多路复用
# ============================================================
CONFIG_XRAY_MUX=n                  # 启用 mux
CONFIG_XRAY_MUX_CONCURRENCY=8
CONFIG_XRAY_MUX_XUDP_CONCURRENCY=16

# ============================================================
# Geo 文件自动更新
# ============================================================
CONFIG_XRAY_GEO_UPDATE=y           # 自动更新 geoip/geosite
CONFIG_XRAY_GEO_UPDATE_URL=https://github.com/Loyalsoldier/v2ray-rules-dat/releases/latest/download
CONFIG_XRAY_GEO_UPDATE_INTERVAL=86400  # 24小时

# ============================================================
# 日志级别
# ============================================================
# debug, info, warning, error, none
CONFIG_XRAY_LOG_LEVEL=warning

# ============================================================
# 订阅设置 (复用 shadowsocks 订阅逻辑或独立)
# ============================================================
CONFIG_XRAY_SUB_ENABLE=n
CONFIG_XRAY_SUB_URL=
CONFIG_XRAY_SUB_INTERVAL=3600
CONFIG_XRAY_SUB_KEYWORD=